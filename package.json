{
  "name": "portals",
  "version": "0.1.0",
  "private": true,
  "description": "Portals: a co-op spaceship game played by flinging parts between phones",
  "scripts": {
    "postinstall": "npm --prefix server install --no-fund --no-audit",
    "start": "npm --prefix server start",
    "check": "npm --prefix server run check",
    "latency": "node server/scripts/latency.mjs",
    "ios": "cap sync ios && cap open ios",
    "android": "cap sync android && cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2"
  }
}
